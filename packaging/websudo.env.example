# websudo configuration example.
# Copy this file to /etc/websudo/websudo.env as an administrator and edit as needed.
# websudo reads this file directly; process environment variables do not override it.

# Explicit loopback IP and non-zero port for the local websudo approval daemon.
WEBSUDO_WEB_ADDR=127.0.0.1:17878

# How long an askpass approval request may stay valid, as a positive integer number of seconds.
WEBSUDO_APPROVAL_TIMEOUT_SECONDS=600

# Absolute path to the selected sudo-compatible binary (for example sudo or sudo-rs).
WEBSUDO_SUDO_PATH=/usr/bin/sudo
